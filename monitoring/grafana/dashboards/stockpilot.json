{
  "annotations": { "list": [] },
  "editable": true,
  "title": "StockPilot 관측성",
  "uid": "stockpilot-observability",
  "tags": ["stockpilot", "local"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus target up",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "max(up{job=\"stock-pilot\"})" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP requests total",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(http_server_requests_seconds_count{application=\"stock-pilot\"})" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kafka records consumed",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(kafka_consumer_fetch_manager_records_consumed_total{application=\"stock-pilot\"})" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVM heap used",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{application=\"stock-pilot\",area=\"heap\"})" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP request rate by URI",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{uri}}",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"stock-pilot\"}[1m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP latency p95 by URI",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{uri}}",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"stock-pilot\"}[5m])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka consumer records rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{client_id}}",
          "expr": "sum by (client_id) (rate(kafka_consumer_fetch_manager_records_consumed_total{application=\"stock-pilot\"}[1m]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM heap/nonheap used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{area}}",
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"stock-pilot\"})"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Business metrics when APIs are exercised",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "recommendation cache {{result}}", "expr": "sum by (result) (rate(stockpilot_recommendation_cache_total[1m]))" },
        { "refId": "B", "legendFormat": "like registered", "expr": "rate(stockpilot_like_registered_total[1m])" },
        { "refId": "C", "legendFormat": "ranking view", "expr": "rate(stockpilot_ranking_view_total[1m])" },
        { "refId": "D", "legendFormat": "alert triggered", "expr": "rate(stockpilot_alert_triggered_total[1m])" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Recommendation compute p95",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(stockpilot_recommendation_compute_seconds_bucket[5m])) by (le))"
        }
      ]
    }
  ]
}
